endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

# ── Authoritative version: change ONE value here ─────────────────────────────
set racket_version "0.8.0-alpha"

# sv_hostname is set dynamically at startup from racket_version (see sunset_core).
# The static fallback below is overridden immediately; it exists only so FiveM
# has something to display before the first resource finishes loading.
sv_hostname "Racket RPG v0.8.0-alpha"
sets sv_projectName "Racket RPG"
sets sv_projectDesc "Racket RPG — build your story."
sets tags "rpg, racket, english, romanian"
sets locale "en-US"

sv_maxclients 48
sv_enforceGameBuild 3751 # mp2025_02 — A Safehouse in the Hills
load_server_icon "fivem.png"

sv_licenseKey "__LICENSE_KEY__"
set mysql_connection_string "__MYSQL_CONNECTION_STRING__"

# ═══ SYSTEM ═══
ensure mapmanager
ensure sessionmanager
ensure hardcap

# ═══ OX + VOICE ═══
ensure ox_lib
ensure pma-voice
setr voice_useNativeAudio true
setr voice_useSendingRangeOnly false
setr voice_enableUi 0
setr voice_enableRadios 1
setr voice_enablePhones 1
setr voice_defaultCycle Z
# OneSync - required: server-side entity authority for damage gating and lookups
set onesync on
set onesync_population false
# [STATEBAG FIX] pma-voice (and other client libs) write LocalPlayer.state from
# the client; strict mode blocks them and spams warnings + breaks voice HUD.
setr sv_stateBagStrictMode false
# [A/B NOFX] 0 = normal mode (animations, filters, backgrounds enabled).
# Was 1 for the login-freeze A/B isolation test — test complete, fix applied.
# NOTE: setr (replicated) — the CLIENT reads it via GetConvar.
setr sv_sunset_nofx 0

# [JOBS DEBUG] 0 = normal production mode (1 = verbose logging for job vehicle registration).
set sv_sunset_jobs_debug 0

# ═══ DEV / PRODUCTION SPLIT ═══
# Convention: every line prefixed with "#@dev " is DEV-ONLY. docker/fivem/entrypoint.sh
# strips the prefix ONLY when SUNSET_DEV=1 is set in .env (never on production).
# sunset_dev is the master convar; dev resources also refuse to run when it is 0.
# Dev resources: sunset_testdriver, sunset_test_agent (MCP bridge), sunset_devtools,
# sunset_admintools. See docs/release/CLEANUP_REPORT.md and docs/testing/FIVEM_MCP.md.
setr sunset_dev "__SUNSET_DEV__"
set testdriver_autorun 0
#@dev ensure sunset_testdriver
#@dev set testdriver_autorun 1
#@dev ensure sunset_test_agent
#@dev setr sunset_test_agent_enabled "__TEST_AGENT_ENABLED__"
#@dev set sunset_test_agent_token "__TEST_AGENT_TOKEN__"
#@dev setr sv_sunset_nuidebug "__TEST_AGENT_NUIDEBUG__"
#@dev ensure sunset_devtools
#@dev setr sunset_devtools_enabled true
#@dev ensure sunset_admintools

# ox_inventory optional — enable after bridge migration
# ensure ox_inventory


endpoint_add_tcp "0.0.0.0:@@FIVEM_PORT@@"
endpoint_add_udp "0.0.0.0:@@FIVEM_PORT@@"

# State bag protection & OneSync runtime (+set onesync on is passed via CLI entrypoint)
setr sv_stateBagStrictMode true

sv_licenseKey "@@FIVEM_LICENSE_KEY@@"
sv_hostname "@@SERVER_NAME@@"
sets sv_projectName "@@SERVER_NAME@@"
sets sv_projectDesc "Modular custom RPG framework MVP"
sets locale "en-US"
sets tags "rpg,custom-framework,development"
sv_maxclients @@MAX_CLIENTS@@
sv_scriptHookAllowed 0
setr sv_showBusySpinnerOnLoadingScreen false

set mysql_connection_string "user=@@MYSQL_USER@@;password=@@MYSQL_PASSWORD@@;host=@@MYSQL_HOST@@;database=@@MYSQL_DATABASE@@;charset=utf8mb4"
set mysql_slow_query_warning 250
set mysql_debug false

ensure mapmanager
ensure oxmysql
ensure bob74_ipl

# Framework Resources (Strictly Acyclic DAG)
ensure rpg_core
ensure rpg_ui
ensure rpg_auth
ensure rpg_spawn
ensure rpg_economy
ensure rpg_factions
ensure rpg_housing
ensure rpg_vehicles
ensure rpg_admin
ensure rpg_chat

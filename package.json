{
  "name": "racket-repository-checks",
  "private": true,
  "scripts": {
    "i18n:check": "node scripts/i18n-gate.mjs --strict",
    "i18n:test": "node --test scripts/i18n-gate.test.mjs",
    "auth:check": "node scripts/test-auth-identity.js",
    "authority:check": "node scripts/test-critical-authority.js",
    "prelaunch:check": "node scripts/test-prelaunch-invariants.js",
    "launch:check": "node --test scripts/test-launch-invariants.js",
    "shop:check": "node scripts/test-shop.js",
    "vehicle-thumbs:check": "node scripts/check-vehicle-thumbs.js && node scripts/test-vehicle-thumb-catalog.js",
    "progression:check": "node scripts/test-progression.js",
    "discover:vehicles": "node scripts/audit-server-vehicles.js --write",
    "restore:pack-handling": "node scripts/restore-pack-handling-ids.js",
    "audit:vehicles": "node scripts/audit-server-vehicles.js --check && node scripts/restore-pack-handling-ids.js --check && node scripts/audit-handling-reversion.js && node scripts/check-lua-syntax.js resources/[sunset]/sunset_vehicle_dynamics resources/[sunset]/sunset_tuning",
    "verify:pack-handling": "node scripts/verify-pack-handling-refs.js"
  },
  "devDependencies": {
    "luaparse": "^0.3.1",
    "parse5": "^7.3.0",
    "typescript": "^5.8.2"
  }
}

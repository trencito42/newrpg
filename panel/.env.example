# FiveM MySQL / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rpgblipmade
DB_PASSWORD=change_me_password
DB_NAME=rpgblipmade

# Web Session & Cookie Encryption (min 32 chars)
SESSION_SECRET=generate_a_random_64_character_hex_secret_here

# Public Branding & Metadata
NEXT_PUBLIC_SERVER_NAME="RPG Server"
NEXT_PUBLIC_SERVER_IP=""
NEXT_PUBLIC_DISCORD_URL=""

# Only enable when Next.js listens on loopback behind a trusted reverse proxy
# that overwrites X-Real-IP and preserves the public Host/Origin.
PANEL_TRUST_PROXY=0
PANEL_PUBLIC_ORIGIN=https://rpg.example.com

# Node Environment
NODE_ENV=production
PORT=3000

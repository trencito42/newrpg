{
  "name": "sunset-rpg-panel",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "i18n:check": "node ../scripts/i18n-gate.mjs --strict",
    "sync:shop-catalog": "node ../scripts/sync-shop-catalog.mjs",
    "check:shop-catalog": "node ../scripts/check-shop-catalog.mjs",
    "build": "npm run sync:shop-catalog && npm run i18n:check && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.14",
    "mysql2": "^3.13.0",
    "next": "^15.2.1",
    "nodemailer": "^10.0.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
